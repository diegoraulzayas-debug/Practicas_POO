  <!-- 3. DIAGRAMA DE FLUJO: Paralelogramo.calcularArea -->
  <!-- ========================================== -->
  <diagram id="diagram_flujo_paralelogramo" name="Diagrama de flujo — Paralelogramo.calcularArea()">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="p_node_start" value="● Inicio" style="shape=ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;strokeWidth=2;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="120" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="p_node_calc1" value="base = vertice2.x - vertice1.x&#xa;altura = vertice4.y - vertice1.y" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="130" width="220" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="p_node_dec1" value="¿base &lt; 0?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="230" width="140" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="p_node_act1" value="base = -base" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
