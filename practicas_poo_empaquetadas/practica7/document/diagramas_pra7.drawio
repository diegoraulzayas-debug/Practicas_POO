  <!-- ========================================== -->
  <!-- 2. DIAGRAMA DE FLUJO: Trapezoide.calcularArea -->
  <!-- ========================================== -->
  <diagram id="diagram_flujo_trapezoide" name="Diagrama de flujo — Trapezoide.calcularArea()">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1400" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Inicio -->
        <mxCell id="t_node_start" value="● Inicio" style="shape=ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;strokeWidth=2;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="120" height="50" as="geometry" />
        </mxCell>
        
        <!-- Proceso calculo diferencias -->
        <mxCell id="t_node_calc1" value="baseM = vertice2.x - vertice1.x&#xa;basem = vertice3.x - vertice4.x&#xa;altura = vertice4.y - vertice1.y" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="305" y="130" width="230" height="70" as="geometry" />
        </mxCell>
        
        <!-- Decision baseM -->
        <mxCell id="t_node_dec1" value="¿baseM &lt; 0?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="240" width="140" height="70" as="geometry" />
        </mxCell>
        
        <!-- Accion baseM neg -->
        <mxCell id="t_node_act1" value="baseM = -baseM" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="250" width="130" height="50" as="geometry" />
        </mxCell>
        
        <!-- Merge 1 -->
        <mxCell id="t_node_m1" value="" style="rhombus;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="350" width="80" height="50" as="geometry" />
        </mxCell>
        
        <!-- Decision basem -->
        <mxCell id="t_node_dec2" value="¿basem &lt; 0?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="440" width="140" height="70" as="geometry" />
        </mxCell>
        
        <!-- Accion basem neg -->
        <mxCell id="t_node_act2" value="basem = -basem" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="450" width="130" height="50" as="geometry" />
        </mxCell>
        
        <!-- Merge 2 -->
        <mxCell id="t_node_m2" value="" style="rhombus;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="550" width="80" height="50" as="geometry" />
        </mxCell>
        
        <!-- Decision altura -->
        <mxCell id="t_node_dec3" value="¿altura &lt; 0?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="640" width="140" height="70" as="geometry" />
        </mxCell>
        
        <!-- Accion altura neg -->
        <mxCell id="t_node_act3" value="altura = -altura" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="650" width="130" height="50" as="geometry" />
        </mxCell>
        
        <!-- Merge 3 -->
        <mxCell id="t_node_m3" value="" style="rhombus;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="750" width="80" height="50" as="geometry" />
        </mxCell>
        
        <!-- Formula Area -->
        <mxCell id="t_node_calc2" value="this.area = ((baseM + basem) * altura) / 2.0&#xa;resultado = this.area" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="840" width="260" height="60" as="geometry" />
        </mxCell>
        
        <!-- SESE Merge Final -->
        <mxCell id="t_node_m_final" value="" style="rhombus;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;strokeWidth=1.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="940" width="90" height="60" as="geometry" />
        </mxCell>
        
        <!-- Fin -->
        <mxCell id="t_node_end" value="◉ Fin" style="shape=ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;strokeWidth=2.5;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="1040" width="120" height="50" as="geometry" />
        </mxCell>
        
        <!-- Transiciones -->
        <mxCell id="e_t_0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="t_node_start" target="t_node_calc1" />
        <mxCell id="e_t_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="t_node_calc1" target="t_node_dec1" />
        <mxCell id="e_t_2_yes" value="[sí]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontColor=#000000;" edge="1" parent="1" source="t_node_dec1" target="t_node_act1" />
        <mxCell id="e_t_2_no" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontColor=#000000;" edge="1" parent="1" source="t_node_dec1" target="t_node_m1" />
        <mxCell id="e_t_2_act" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="t_node_act1" target="t_node_m1" />
        
        <mxCell id="e_t_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="t_node_m1" target="t_node_dec2" />
        <mxCell id="e_t_4_yes" value="[sí]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontColor=#000000;" edge="1" parent="1" source="t_node_dec2" target="t_node_act2" />
        <mxCell id="e_t_4_no" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontColor=#000000;" edge="1" parent="1" source="t_node_dec2" target="t_node_m2" />
        <mxCell id="e_t_4_act" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="t_node_act2" target="t_node_m2" />
        
        <mxCell id="e_t_5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="t_node_m2" target="t_node_dec3" />
        <mxCell id="e_t_6_yes" value="[sí]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontColor=#000000;" edge="1" parent="1" source="t_node_dec3" target="t_node_act3" />
        <mxCell id="e_t_6_no" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontColor=#000000;" edge="1" parent="1" source="t_node_dec3" target="t_node_m3" />
        <mxCell id="e_t_6_act" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="t_node_act3" target="t_node_m3" />
        
        <mxCell id="e_t_7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="t_node_m3" target="t_node_calc2" />
        <mxCell id="e_t_8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="t_node_calc2" target="t_node_m_final" />
        <mxCell id="e_t_9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;html=1;" edge="1" parent="1" source="t_node_m_final" target="t_node_end" />
      </root>
    </mxGraphModel>
  </diagram>

